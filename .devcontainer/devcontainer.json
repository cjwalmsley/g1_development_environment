{
  "name": "Unitree G1 ROS 2 Humble Dev Workspace",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "g1-dev-linux",
  "customizations": {
    "jetbrains": {
      "backend": "clion"
    },
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-python.python",
        "twxs.cmake"
      ]
    }
  },
  "remoteEnv": {
    "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
    "CYCLONEDDS_HOME": "/opt/cyclonedds"
  },
  "shutdownAction": "stopCompose",
  "postCreateCommand": "colcon build --build-base /root/build --install-base /root/install"
}
