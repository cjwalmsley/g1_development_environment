<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>
            <!-- Disable multicast, rely solely on direct IP connection -->
            <AllowMulticast>false</AllowMulticast>
        </General>
        <Discovery>
            <Peers>
                <!-- Point directly at the sensory compute IP -->
                <Peer address="192.168.123.161"/>
                <Peer address="192.168.123.164"/>
            </Peers>
        </Discovery>
    </Domain>
</CycloneDDS>
